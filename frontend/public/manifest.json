{
  "name": "Trinetra: Digital Trust & Provenance",
  "short_name": "Trinetra",
  "description": "Share any suspicious image and get a Provenance Passport in seconds",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#060D1F",
  "theme_color": "#060D1F",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "image",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
